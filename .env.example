# Copy this file to `.env` for local dev, and add the same variables in Vercel
# (Project → Settings → Environment Variables) for production.

# The id from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_LONG_ID/edit
VITE_SHEET_ID=

# The tab (worksheet) name to read. Defaults to "Sheet1" if left blank.
VITE_SHEET_NAME=Sheet1
